{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mandate/schema-v1",
  "title": "Mandate CBAM Canonical Data Model v1",
  "description": "逐字對照《可信碳排證據Agent_VibeCodingAI完整工程規格與指令手冊》p.7 Canonical Data Model 的必填欄位；不得私自改名（文件 p.5 明文規定）。新增選填欄位可向後相容；刪除、改名、型別或語意變更必須升 schemaVersion（文件 p.7 版本規則）。",
  "schemaVersion": "v1",
  "definitions": {

    "CaseStatus": {
      "type": "string",
      "description": "Case 狀態機（文件 p.4，7 態）",
      "enum": ["DRAFT", "NEEDS_EVIDENCE", "METHOD_REVIEW", "READY_FOR_VERIFIER", "VERIFIER_REVIEW", "BLOCKED", "ARCHIVED"]
    },

    "GateDecision": {
      "type": "string",
      "description": "GateResult.decision（文件 p.11 Final Mapping）",
      "enum": ["GATE_OK", "NEEDS_EVIDENCE", "METHOD_REVIEW", "BLOCKED"]
    },

    "ReasonCode": {
      "type": "string",
      "description": "見 packages/contracts/enums.js 的 REASON_CODE；後半段標 NOT IN SPEC 的是 carbon-core 自行補充，待與隊友確認命名",
      "enum": [
        "AUTHORIZATION_INVALID", "AUTHORIZATION_REVOKED", "CASE_CONTEXT_MISMATCH",
        "EVIDENCE_MISSING", "EVIDENCE_PERIOD_INCOMPLETE",
        "FACTOR_NOT_ALLOWED", "FACTOR_EXPIRED", "POLICY_NOT_APPLICABLE",
        "PROOF_INVALID", "PROOF_EXPIRED", "NONCE_REUSED",
        "PUBLIC_INPUT_MISMATCH", "PROOF_CONTEXT_MISMATCH", "AGENT_REVIEW_REQUIRED", "GATE_OK",
        "ALLOCATION_EXCEEDS_PRODUCTION", "DUPLICATE_SHIPMENT_ID", "UNKNOWN_UNIT",
        "ZERO_OR_NEGATIVE_QUANTITY", "INVALID_REPORTING_YEAR", "CALCULATION_OVERFLOW",
        "MISSING_CALCULATION_CONTEXT", "INTENSITY_MISMATCH"
      ]
    },

    "VerificationStatus": {
      "type": "string",
      "description": "NOT IN SPEC 的值域選擇——文件只給欄位名稱 verificationStatus，沒列舉值。carbon-core 定義：draft=供應商尚未確認；confirmed=供應商已確認可送 Gate。跟『合格 CBAM 查驗員正式查驗完成』是不同層次，待跟隊友確認。",
      "enum": ["draft", "confirmed"]
    },

    "AllocationStatus": {
      "type": "string",
      "description": "Shipment.allocationStatus——文件只給欄位名稱，沒列舉值。carbon-core 沿用 CaseStatus 裡由 Gate 直接可達的子集。",
      "enum": ["NEEDS_EVIDENCE", "METHOD_REVIEW", "READY_FOR_VERIFIER", "BLOCKED"]
    },

    "FactorPurpose": {
      "type": "string",
      "description": "落地風險審查修正版方案 p.9（本文件優先權表 p.2：Vibe Coding 規格沒定義的欄位值域，落地風險審查版補）",
      "enum": ["TW_INVENTORY", "CBAM_ACTUAL", "CBAM_DEFAULT", "PACT"]
    },

    "EvidenceType": {
      "type": "string",
      "enum": ["electricity_bill", "fuel_ledger", "production_report", "precursor_list"]
    },

    "Case": {
      "type": "object",
      "description": "文件 p.7",
      "required": ["caseId", "title", "supplierOrgId", "importerOrgId", "cnCode", "status", "createdAt", "policyProfileId"],
      "additionalProperties": true,
      "properties": {
        "caseId": { "type": "string" },
        "title": { "type": "string" },
        "supplierOrgId": { "type": "string" },
        "importerOrgId": { "type": "string" },
        "cnCode": { "type": "string" },
        "status": { "$ref": "#/definitions/CaseStatus" },
        "createdAt": { "type": "string", "format": "date-time" },
        "policyProfileId": { "type": "string" }
      }
    },

    "InstallationYear": {
      "type": "object",
      "description": "文件 p.7——法定基礎層",
      "required": [
        "installationId", "operatorOrgId", "reportingYear", "productionRoute",
        "systemBoundaryVersion", "productionTonnes", "verifiedIntensity", "verificationStatus"
      ],
      "additionalProperties": true,
      "properties": {
        "installationId": { "type": "string" },
        "operatorOrgId": { "type": "string" },
        "reportingYear": { "type": "integer" },
        "productionRoute": { "type": "string" },
        "systemBoundaryVersion": { "type": "string", "description": "待與碳專家/教授確認邊界定義後填入正式版本號" },
        "productionTonnes": { "type": "number", "exclusiveMinimum": 0 },
        "verifiedIntensity": { "type": "number", "exclusiveMinimum": 0, "description": "tCO2e/tonne，單位固定，不另外帶 unit 欄位" },
        "verificationStatus": { "$ref": "#/definitions/VerificationStatus" },
        "evidenceCoverage": {
          "type": "object",
          "description": "NOT IN SPEC，carbon-core 為了 missing_period fixture 需要而加：所有證據涵蓋期間的聯集",
          "required": ["periodStart", "periodEnd"],
          "properties": {
            "periodStart": { "type": "string", "format": "date" },
            "periodEnd": { "type": "string", "format": "date" }
          }
        },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Shipment": {
      "type": "object",
      "description": "文件 p.7——交易分攤層",
      "required": ["shipmentId", "caseId", "installationId", "reportingYear", "quantityTonnes", "allocatedEmissions", "allocationStatus"],
      "additionalProperties": true,
      "properties": {
        "shipmentId": { "type": "string" },
        "caseId": { "type": "string" },
        "installationId": { "type": "string" },
        "reportingYear": { "type": "integer" },
        "quantityTonnes": { "type": "number", "exclusiveMinimum": 0 },
        "allocatedEmissions": { "type": ["number", "null"], "description": "tCO2e；被 Gate 擋掉時為 null" },
        "allocationStatus": { "$ref": "#/definitions/AllocationStatus" },
        "factorSetId": { "type": ["string", "null"] },
        "policyProfileId": { "type": ["string", "null"] }
      }
    },

    "EvidenceItem": {
      "type": "object",
      "description": "文件 p.7",
      "required": ["evidenceId", "caseId", "type", "fileHash", "coveredFrom", "coveredTo", "source", "version", "humanConfirmed", "vaultRef"],
      "additionalProperties": true,
      "properties": {
        "evidenceId": { "type": "string" },
        "caseId": { "type": "string" },
        "type": { "$ref": "#/definitions/EvidenceType" },
        "fileHash": { "type": "string" },
        "coveredFrom": { "type": "string", "format": "date" },
        "coveredTo": { "type": "string", "format": "date" },
        "source": { "type": "string" },
        "version": { "type": "integer" },
        "humanConfirmed": { "type": "boolean" },
        "vaultRef": { "type": "string" }
      }
    },

    "IdentityContext": {
      "type": "object",
      "description": "文件 p.7——Phase 3 才會實際用到，先卡欄位",
      "required": ["actorId", "orgId", "role", "assuranceLevel", "credentialRefs", "mandateId", "expiresAt", "revocationStatus"],
      "additionalProperties": true,
      "properties": {
        "actorId": { "type": "string" },
        "orgId": { "type": "string" },
        "role": { "type": "string", "enum": ["Supplier", "Importer", "Verifier", "Agent", "PolicyAdmin"] },
        "assuranceLevel": { "type": "string" },
        "credentialRefs": { "type": "array", "items": { "type": "string" } },
        "mandateId": { "type": ["string", "null"] },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "revocationStatus": { "type": "string" }
      }
    },

    "FactorSet": {
      "type": "object",
      "description": "文件 p.7",
      "required": ["factorSetId", "issuer", "purpose", "version", "effectiveFrom", "effectiveTo", "sourceHash", "status"],
      "additionalProperties": true,
      "properties": {
        "factorSetId": { "type": "string" },
        "issuer": { "type": "string" },
        "purpose": { "$ref": "#/definitions/FactorPurpose" },
        "version": { "type": "string" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": ["string", "null"], "format": "date" },
        "sourceHash": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["active", "expired", "revoked"] }
      }
    },

    "PolicyProfile": {
      "type": "object",
      "description": "文件 p.7",
      "required": ["policyProfileId", "cnCodes", "reportingYear", "allowedFactorSets", "requiredEvidence", "circuitId", "status"],
      "additionalProperties": true,
      "properties": {
        "policyProfileId": { "type": "string" },
        "cnCodes": { "type": "array", "items": { "type": "string" } },
        "reportingYear": { "type": "integer" },
        "allowedFactorSets": { "type": "array", "items": { "type": "string" } },
        "requiredEvidence": { "type": "array", "items": { "$ref": "#/definitions/EvidenceType" } },
        "circuitId": { "type": ["string", "null"], "description": "Phase 3 才會填，Phase 1 可為 null" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      }
    },

    "ProofEnvelope": {
      "type": "object",
      "description": "文件 p.7——Phase 3 才會實際用到，先卡欄位",
      "required": ["proofId", "circuitId", "publicInputs", "proof", "nonce", "expiresAt", "verificationKeyId"],
      "additionalProperties": true,
      "properties": {
        "proofId": { "type": "string" },
        "circuitId": { "type": "string" },
        "publicInputs": { "type": "object" },
        "proof": { "type": "string" },
        "nonce": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "verificationKeyId": { "type": "string" }
      }
    },

    "GateResult": {
      "type": "object",
      "description": "文件 p.7——注意 reasonCodes 是陣列，不是單一值",
      "required": ["decision", "reasonCodes", "checks", "policyProfileId", "evaluatedAt", "inputHash"],
      "additionalProperties": true,
      "properties": {
        "decision": { "$ref": "#/definitions/GateDecision" },
        "reasonCodes": { "type": "array", "items": { "$ref": "#/definitions/ReasonCode" } },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
              "detail": { "type": "string" }
            }
          }
        },
        "policyProfileId": { "type": ["string", "null"] },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "inputHash": { "type": "string" },
        "shipmentId": { "type": ["string", "null"], "description": "NOT IN SPEC 的擴充欄位：文件的 GateResult 沒有綁 shipmentId，但 carbon-core 逐批出貨評估需要知道是哪一批的結果" }
      }
    },

    "RiskReport": {
      "type": "object",
      "description": "文件 p.7——Phase 4（Evidence Agent）才會實際用到，先卡欄位",
      "required": ["findings", "missingEvidence", "discrepancies", "citations", "modelVersion", "promptVersion", "reviewStatus"],
      "additionalProperties": true,
      "properties": {
        "findings": { "type": "array" },
        "missingEvidence": { "type": "array" },
        "discrepancies": { "type": "array" },
        "citations": { "type": "array" },
        "modelVersion": { "type": "string" },
        "promptVersion": { "type": "string" },
        "reviewStatus": { "type": "string" }
      }
    },

    "CalculationReceipt": {
      "type": "object",
      "description": "NOT IN SPEC 的具體形狀——文件 p.5/p.10 只講『輸入 Hash、方法／factor 版本、結果、時間』，沒給正式 schema，這是 carbon-core 依描述設計的形狀",
      "required": ["inputHash", "installationId", "reportingYear", "policyProfileId", "factorSetId", "metadata", "result", "computedAt"],
      "additionalProperties": true,
      "properties": {
        "inputHash": { "type": "string" },
        "installationId": { "type": "string" },
        "reportingYear": { "type": "integer" },
        "policyProfileId": { "type": "string" },
        "factorSetId": { "type": "string" },
        "metadata": {
          "type": "object",
          "required": ["factor", "policy", "scale", "roundingRule", "methodVersion"],
          "properties": {
            "factor": {
              "type": "object",
              "required": ["factorSetId", "version", "sourceHash"],
              "properties": {
                "factorSetId": { "type": "string" },
                "version": { "type": "string" },
                "sourceHash": { "type": "string" }
              }
            },
            "policy": {
              "type": "object",
              "required": ["policyProfileId", "version"],
              "properties": {
                "policyProfileId": { "type": "string" },
                "version": { "type": "string" }
              }
            },
            "scale": { "type": "integer" },
            "roundingRule": { "type": "string" },
            "methodVersion": { "type": "string" }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "totalEmissionsScaled": { "type": "integer" },
            "totalEmissions": { "type": "number" }
          }
        },
        "computedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
