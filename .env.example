# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: route CarbonDataAgent / AuthAgent (see server/llm.js) to different
# models via OpenRouter's multi-model routing. Leave blank to fall back to
# OPENAI_MODEL for both -- nothing else changes if unset.
# OPENAI_MODEL_CARBON=openai/gpt-4o-mini
# OPENAI_MODEL_AUTH=openai/gpt-4o-mini

# Optional: double-write audit log / approvals / AI conversation history to Supabase.
# Leave blank to run fully in-memory (default) — nothing else changes if unset.
# Run supabase/schema.sql in the Supabase SQL editor first. Use the *service role* key
# (server-side only, never exposed to the browser) so inserts bypass RLS.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
