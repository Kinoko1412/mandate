        }
      }
    },
    {
      "id": "demo_attack_tampered_quantity",
      "description": "攻擊情境：Proof 宣稱 quantity 與案件快照不符",
      "request": {
        "method": "POST",
        "path": "/api/demo/attack",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "scenario": "tampered_quantity"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "scenario": "tampered_quantity",
          "decision": "BLOCKED",
          "reasonCodes": ["PUBLIC_INPUT_MISMATCH"],
          "storeModified": false,
          "demoOnly": true
        }
      }
    },
    {
      "id": "demo_attack_wrong_factor",
      "description": "攻擊情境：factorSet 不在 Policy 允許清單",
      "request": {
        "method": "POST",
        "path": "/api/demo/attack",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "scenario": "wrong_factor"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "scenario": "wrong_factor",
          "decision": "BLOCKED",
          "reasonCodes": ["FACTOR_NOT_ALLOWED"],
          "storeModified": false,
          "demoOnly": true
        }
      }
    },
    {
      "id": "demo_attack_proof_context_swap",
      "description": "攻擊情境：SHIP-A Proof 套到 SHIP-B",
      "request": {
        "method": "POST",
        "path": "/api/demo/attack",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "scenario": "proof_context_swap"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "scenario": "proof_context_swap",
          "decision": "BLOCKED",
          "reasonCodes": ["PROOF_CONTEXT_MISMATCH"],
          "storeModified": false,
          "demoOnly": true
        }
      }
    },
    {
      "id": "demo_attack_invalid_scenario",
      "description": "拒絕任意 scenario／攻擊者自帶 envelope",
      "request": {
        "method": "POST",
        "path": "/api/demo/attack",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "scenario": "arbitrary_envelope",
          "envelope": { "proof": "attacker-controlled" }
        }
      },
      "response": {
        "status": 400,
        "body": {
          "code": "DEMO_SCENARIO_INVALID",
          "message": "scenario 必須是固定攻擊情境。",
          "retryable": false,
          "details": {
            "allowedScenarios": [
              "tampered_quantity",
              "wrong_factor",
              "proof_context_swap"
            ]
          }
        }
      }
    },
    {
      "id": "physical_reality_post",
      "description": "物理真實邊界（文件一致 ≠ 儀表已校正）",
      "request": {
        "method": "POST",
        "path": "/api/demo/physical-reality",
        "headers": {
          "x-demo-role": "Importer",
          "content-type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "scenario": "consistent_documents_but_uncalibrated_meter",
          "documentConsistencyVerified": true,
          "commitmentVerified": true,
          "gateScope": "DATA_CONSISTENCY_ONLY",
          "physicalRealityVerified": false,
          "finding": "文件數字彼此一致，但現場儀表失效或未校正，資料一致性不能證明物理真實。",
          "recommendedAction": "ONSITE_VERIFICATION",
          "nextStep": "轉交查驗員檢查校正紀錄，並安排實地查驗。",
          "caseStatusUnchanged": true,
          "gateUnchanged": true,
          "demoOnly": true
        }
      }
    },
    {
      "id": "physical_reality_get",
