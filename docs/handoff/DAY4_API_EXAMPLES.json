        "method": "POST",
        "path": "/api/workflow/revalidate",
        "headers": {
          "x-demo-role": "Importer",
          "content-type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 403,
        "body": {
          "code": "ROLE_FORBIDDEN",
