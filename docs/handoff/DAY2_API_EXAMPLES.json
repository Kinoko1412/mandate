              }
            ],
            "evidenceCompleteness": {
              "required": [
                "electricity_bill",
                "fuel_ledger",
                "production_report",
                "precursor_list"
              ],
              "received": [
                "electricity_bill",
                "fuel_ledger",
                "production_report",
                "precursor_list"
              ],
