    {
      "id": "vault_grant_create",
      "description": "Supplier 建立短效 Grant；plaintext token 僅此回應出現一次",
      "request": {
        "method": "POST",
        "path": "/api/vault/grants",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "caseId": "CASE-2026-001",
          "evidenceIds": [
            "EV-UPLOAD-01"
          ],
          "subject": "demo-verifier-001",
          "expiresAt": "2026-08-25T12:05:00.000Z"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "grant": {
            "grantId": "grant_0001",
            "caseId": "CASE-2026-001",
            "evidenceIds": [
              "EV-UPLOAD-01"
            ],
            "subjectActorId": "demo-verifier-001",
            "expiresAt": "2026-08-25T12:05:00.000Z",
            "oneTime": true,
            "demoOnly": true
          },
          "token": "<REDACTED_ONE_TIME_GRANT_TOKEN>"
        },
        "notes": [
          "grant 物件不含 tokenHash。",
          "Audit 事件 VAULT_GRANT_CREATE 不記錄 token。"
        ]
      }
    },
    {
      "id": "vault_open_success",
      "description": "Verifier 使用有效 Grant 開啟底稿一次",
      "request": {
        "method": "GET",
        "path": "/api/vault/items/EV-UPLOAD-01",
        "headers": {
          "x-demo-role": "Verifier",
          "x-vault-token": "<REDACTED_ONE_TIME_GRANT_TOKEN>"
