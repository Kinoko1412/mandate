        "method": "GET",
        "path": "/api/vault/items/EV-UPLOAD-01/download",
        "headers": {
          "x-demo-role": "Verifier",
          "x-vault-token": "<REDACTED_ONE_TIME_GRANT_TOKEN>"
        }
      },
      "response": {
        "status": 403,
        "body": {
          "code": "GRANT_INVALID",
          "message": "Grant 無效、已使用或不符合此底稿。",
          "retryable": false,
          "details": null
        }
      }
    },
