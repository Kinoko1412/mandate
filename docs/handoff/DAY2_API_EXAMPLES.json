{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day 2 Workflow API Examples",
  "description": "Machine-readable examples aligned with server/workflowApi.js. Grant plaintext tokens are masked. No real secrets.",
  "baseUrl": "http://127.0.0.1:3847",
  "demoActors": {
    "Supplier": {
      "actorId": "demo-supplier-001",
      "orgId": "ORG-TW-STEEL-SUPPLIER",
      "role": "Supplier",
      "demoOnly": true
    },
    "Importer": {
      "actorId": "demo-importer-001",
      "orgId": "ORG-EU-IMPORTER-DEMO",
      "role": "Importer",
      "demoOnly": true
    },
    "Verifier": {
      "actorId": "demo-verifier-001",
      "orgId": "ORG-CBAM-VERIFIER-DEMO",
      "role": "Verifier",
      "demoOnly": true
    }
  },
  "fixedCaseId": "CASE-2026-001",
  "carbonPreviewContract": {
    "previewOnly": true,
    "clientSuppliedInput": true,
    "persistence": "回應僅供預覽，不寫入 workflow case 或 carbon store。"
  },
  "examples": [
    {
      "id": "auth_missing_role",
      "description": "未指定 Demo 角色",
      "request": {
        "method": "GET",
        "path": "/api/cases",
        "headers": {}
      },
      "response": {
        "status": 401,
        "body": {
          "code": "DEMO_ROLE_REQUIRED",
          "message": "請使用 x-demo-role header 或 demoRole query 選擇 Supplier、Importer 或 Verifier。",
          "retryable": false,
          "details": {
            "demoOnly": true
          }
        }
      }
    },
    {
      "id": "cases_list_supplier",
      "description": "Supplier 取得案件列表（摘要遮罩）",
      "request": {
        "method": "GET",
        "path": "/api/cases",
        "headers": {
          "x-demo-role": "Supplier"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "actor": {
            "actorId": "demo-supplier-001",
            "orgId": "ORG-TW-STEEL-SUPPLIER",
            "role": "Supplier",
            "demoOnly": true
          },
          "cases": [
            {
              "caseId": "CASE-2026-001",
              "title": "TW-STEEL-01 2026 年度示範案件",
              "cnCode": "72085100",
              "status": "DRAFT",
              "createdAt": "2026-08-24T09:00:00Z",
              "policyProfileId": "CBAM-STEEL-2026-v1",
              "readiness": "not_verified",
              "readyDisclaimer": "具備送交查驗準備條件，不代表正式查驗完成。",
              "demoOnly": true,
              "evidenceCount": 0,
              "reportingYear": 2026
            }
          ]
        }
      }
    },
    {
      "id": "evidence_upload_success",
      "description": "Supplier 上傳 synthetic Demo evidence（回應不含 contentBase64）",
      "request": {
        "method": "POST",
        "path": "/api/evidence",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "caseId": "CASE-2026-001",
          "filename": "demo-electricity-2026.txt",
          "mediaType": "text/plain",
          "contentBase64": "c3ludGhldGljIGVsZWN0cmljaXR5IGV2aWRlbmNlIDIwMjY=",
          "metadata": {
            "type": "electricity_bill",
            "coveredFrom": "2026-01-01",
            "coveredTo": "2026-12-31",
            "source": "synthetic-demo-electricity_bill"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "evidence": {
            "evidenceId": "EV-UPLOAD-01",
            "caseId": "CASE-2026-001",
            "type": "electricity_bill",
            "fileHash": "sha256:8f4e3c2b1a0d9e8f7c6b5a49382716050493827160504938271605049382716",
            "coveredFrom": "2026-01-01",
            "coveredTo": "2026-12-31",
            "source": "synthetic-demo-electricity_bill",
            "version": 1,
            "humanConfirmed": false,
            "mediaType": "text/plain",
            "sizeBytes": 38,
            "filename": "demo-electricity-2026.txt",
            "vaultRef": "vault-demo://CASE-2026-001/<hash-prefix>"
          }
        },
        "notes": [
          "fileHash 為示意；實際值依 contentBase64 的 SHA-256 計算。",
          "回應 deliberately 省略 contentBase64。"
        ]
      }
    },
    {
      "id": "evidence_duplicate_filename",
      "description": "同名文件不可靜默覆寫",
      "request": {
        "method": "POST",
        "path": "/api/evidence",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "caseId": "CASE-2026-001",
          "filename": "demo-electricity-2026.txt",
          "mediaType": "text/plain",
          "contentBase64": "cmVwbGFjZW1lbnQ=",
          "metadata": {
            "type": "electricity_bill",
            "coveredFrom": "2026-01-01",
            "coveredTo": "2026-12-31",
            "source": "demo"
          }
        }
      },
      "response": {
        "status": 409,
        "body": {
          "code": "EVIDENCE_ALREADY_EXISTS",
          "message": "同名文件已存在；Demo Vault 不會靜默覆寫。",
          "retryable": false,
          "details": {
            "existingEvidenceId": "EV-UPLOAD-01"
          }
        }
      }
    },
    {
      "id": "evidence_media_type_rejected",
      "description": "不允許的 mediaType",
      "request": {
        "method": "POST",
        "path": "/api/evidence",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "caseId": "CASE-2026-001",
          "filename": "malware.exe",
          "mediaType": "application/x-msdownload",
          "contentBase64": "bm90LWV4ZWN1dGFibGU=",
          "metadata": {
            "type": "fuel_ledger",
            "coveredFrom": "2026-01-01",
            "coveredTo": "2026-12-31",
            "source": "demo"
          }
        }
      },
      "response": {
        "status": 400,
        "body": {
          "code": "MEDIA_TYPE_NOT_ALLOWED",
          "message": "此文件類型不在允許清單。",
          "retryable": false,
          "details": {
            "allowedMediaTypes": [
              "application/pdf",
              "application/json",
              "text/plain",
              "image/png",
              "image/jpeg"
            ]
          }
        }
      }
    },
    {
      "id": "evidence_confirm_success",
      "description": "Supplier 人工確認 evidence",
      "request": {
        "method": "POST",
        "path": "/api/evidence/EV-UPLOAD-01/confirm",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {
          "confirmed": true
        }
      },
      "response": {
        "status": 200,
        "body": {
          "evidence": {
            "evidenceId": "EV-UPLOAD-01",
            "humanConfirmed": true,
            "filename": "demo-electricity-2026.txt",
            "vaultRef": "vault-demo://CASE-2026-001/<hash-prefix>"
          }
        }
      }
    },
    {
      "id": "case_submit_missing_evidence",
      "description": "缺件或未確認時提交",
      "request": {
        "method": "POST",
        "path": "/api/cases/CASE-2026-001/submit",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 422,
        "body": {
          "code": "EVIDENCE_MISSING",
          "message": "案件仍有缺件或尚未人工確認的證據。",
          "retryable": false,
          "details": {
            "missingTypes": [
              "fuel_ledger",
              "production_report",
              "precursor_list"
            ],
            "unconfirmedEvidenceIds": []
          }
        }
      }
    },
    {
      "id": "case_submit_success_method_review",
      "description": "四份 evidence 齊全且已確認；Agent/Proof/Gate 仍 unavailable → METHOD_REVIEW",
      "preconditions": [
        "四種 required evidence 已上傳且 humanConfirmed=true"
      ],
      "request": {
        "method": "POST",
        "path": "/api/cases/CASE-2026-001/submit",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "case": {
            "caseId": "CASE-2026-001",
            "status": "METHOD_REVIEW",
            "readiness": "not_verified",
            "demoOnly": true,
            "carbon": {
              "annual": {
                "emissions": 360,
                "emissionsUnit": "tCO2e",
                "intensity": 1.8,
                "intensityUnit": "tCO2e/tonne"
              },
              "shipments": [
                {
                  "shipmentId": "SHIP-A",
                  "allocatedEmissions": 180,
                  "allocationStatus": "METHOD_REVIEW"
                },
                {
                  "shipmentId": "SHIP-B",
                  "allocatedEmissions": 108,
                  "allocationStatus": "METHOD_REVIEW"
                }
              ],
              "demoOnly": true
            },
            "services": {
              "agent": {
                "status": "unavailable",
                "verification": "not_verified",
                "demoOnly": true
              },
              "proof": {
                "status": "unavailable",
                "verification": "not_verified",
                "checks": [],
                "reasonCodes": ["PROOF_SERVICE_UNAVAILABLE"],
                "demoOnly": true
              },
              "gate": {
                "status": "unavailable",
                "verification": "not_verified",
                "checks": [],
                "reasonCodes": ["GATE_SERVICE_UNAVAILABLE"],
                "demoOnly": true
              }
            }
          },
          "readiness": {
            "status": "METHOD_REVIEW",
            "readiness": "not_verified",
            "reasonCodes": ["SERVICE_UNAVAILABLE"],
            "message": "Proof 或 Gate 尚未驗證，因此案件維持 METHOD_REVIEW。"
          }
        },
        "notes": [
          "當 proof+gate 皆 available+verified 時（8/26 trust engine），同一路徑或 revalidate 才可能 READY_FOR_VERIFIER。Agent 可不接。"
        ]
      }
    },
    {
      "id": "importer_summary_masked",
      "description": "Importer 摘要：無 vaultRef、contentBase64、完整 Supplier 底稿",
      "request": {
        "method": "GET",
        "path": "/api/importer/cases/CASE-2026-001/summary",
        "headers": {
          "x-demo-role": "Importer"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "case": {
            "caseId": "CASE-2026-001",
            "cnCode": "72085100",
            "status": "METHOD_REVIEW",
            "annualSummary": {
              "emissions": 360,
              "emissionsUnit": "tCO2e",
              "intensity": 1.8,
              "intensityUnit": "tCO2e/tonne"
            },
            "shipments": [
