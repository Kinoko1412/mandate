        "forbiddenResponseFields": [
          "vaultRef",
          "contentBase64",
          "installationYear",
          "token",
          "calculationReceipt",
          "totalEmissionsScaled",
          "sourceHash"
        ]
      }
    },
    {
      "id": "verifier_evidence_index",
      "description": "Verifier Evidence Index（含 filename，不含 content）",
      "request": {
        "method": "GET",
        "path": "/api/verifier/cases/CASE-2026-001/evidence",
