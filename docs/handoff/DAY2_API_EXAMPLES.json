    {
      "id": "workflow_revalidate_method_review",
      "description": "預設 trust adapter unavailable → METHOD_REVIEW",
      "preconditions": [
        "案件已 submit；carbon 含 calculationReceipt.inputHash"
      ],
      "request": {
        "method": "POST",
        "path": "/api/workflow/revalidate",
        "headers": {
          "x-demo-role": "Supplier",
          "content-type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "case": {
            "caseId": "CASE-2026-001",
            "status": "METHOD_REVIEW",
            "readiness": "not_verified",
            "services": {
              "agent": { "status": "unavailable", "verification": "not_verified" },
              "proof": {
                "status": "unavailable",
                "verification": "not_verified",
                "reasonCodes": ["PROOF_SERVICE_UNAVAILABLE"]
              },
              "gate": {
                "status": "unavailable",
                "verification": "not_verified",
                "reasonCodes": ["GATE_SERVICE_UNAVAILABLE"]
              }
            }
          },
          "readiness": {
